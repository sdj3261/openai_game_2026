{
  "name": "gaia-2126-leaderboard-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --config wrangler.example.toml --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply gaia-leaderboard --local --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply gaia-leaderboard --remote --config wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.120.0"
  }
}
